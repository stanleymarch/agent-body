<style>
  .workspace { flex-direction: column; width: 100; padding-top: 4; padding-bottom: 4; padding-left: 4; padding-right: 4; background-color: #142137; border-radius: 3; }
  .title { font-size: 3.6; font-weight: 700; color: #f0f4ff; margin-bottom: 1; }
  .status { font-size: 2.2; color: #adbedb; margin-bottom: 2; }
  .row { width: 92; flex-direction: row; gap: 1; margin-bottom: 2; }
  .nav { width: 22; min-width: 0; padding-left: 1; padding-right: 1; flex-grow: 1; height: 7; background-color: #2a3d5c; border-radius: 1.5; justify-content: center; }
  .exit { width: 92; }
  .label { font-size: 2.6; color: #ecf2ff; }
  .body { font-size: 2.5; line-height: 1.4; color: #d8e3f7; margin-top: 2; margin-bottom: 3; }
  .field { width: 92; height: 7; margin-bottom: 1.2; padding-left: 2; padding-right: 2; background-color: #263954; border-radius: 1.3; justify-content: flex-start; }
  .action { width: 28; min-width: 0; padding-left: 2; padding-right: 2; height: 7; flex-grow: 1; background-color: #526ea7; border-radius: 1.5; justify-content: center; }
</style>
<div class="workspace">
  <div id="workspace-title" class="title">Ava</div>
  <div id="workspace-status" class="status">Agent Body</div>
  <div class="row">
    <Button id="nav-chat" class="nav"><ButtonLabel class="label">Chat</ButtonLabel></Button>
    <Button id="nav-character" class="nav"><ButtonLabel class="label">Character</ButtonLabel></Button>
    <Button id="nav-connections" class="nav"><ButtonLabel class="label">Connect</ButtonLabel></Button>
    <Button id="nav-memory" class="nav"><ButtonLabel class="label">Memory</ButtonLabel></Button>
  </div>
  <div id="connection-tabs" class="row">
    <Button id="sub-llm" class="nav"><ButtonLabel class="label">LLM</ButtonLabel></Button>
    <Button id="sub-stt" class="nav"><ButtonLabel class="label">STT</ButtonLabel></Button>
    <Button id="sub-tts" class="nav"><ButtonLabel class="label">TTS</ButtonLabel></Button>
    <Button id="sub-transfer" class="nav"><ButtonLabel class="label">QR</ButtonLabel></Button>
  </div>
  <div id="workspace-body" class="body">Select Chat, Character or Connections.</div>
  <Button id="field-0" class="field"><ButtonLabel id="field-label-0" class="label">Field</ButtonLabel></Button>
  <Button id="field-1" class="field"><ButtonLabel id="field-label-1" class="label">Field</ButtonLabel></Button>
  <Button id="field-2" class="field"><ButtonLabel id="field-label-2" class="label">Field</ButtonLabel></Button>
  <Button id="field-3" class="field"><ButtonLabel id="field-label-3" class="label">Field</ButtonLabel></Button>
  <Button id="field-4" class="field"><ButtonLabel id="field-label-4" class="label">Field</ButtonLabel></Button>
  <Button id="field-5" class="field"><ButtonLabel id="field-label-5" class="label">Field</ButtonLabel></Button>
  <div class="row">
    <Button id="workspace-edit-chat" class="action"><ButtonLabel class="label">Write message</ButtonLabel></Button>
    <Button id="workspace-listen" class="action"><ButtonLabel id="workspace-listen-label" class="label">Microphone</ButtonLabel></Button>
    <Button id="workspace-save" class="action"><ButtonLabel class="label">Save</ButtonLabel></Button>
    <Button id="workspace-test-voice" class="action"><ButtonLabel class="label">Test voice</ButtonLabel></Button>
    <Button id="workspace-clear-key" class="action"><ButtonLabel class="label">Clear key</ButtonLabel></Button>
  </div>
  <div id="workspace-feedback" class="status"></div>
  <Button id="workspace-exit" class="nav exit"><ButtonLabel class="label">Return to browser</ButtonLabel></Button>
</div>
