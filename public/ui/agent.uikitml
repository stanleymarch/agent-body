<style>
  @font-face { font-family: 'Workspace Sans'; src: url('../fonts/NotoSans-Regular.ttf'); font-weight: 400; }
  @font-face { font-family: 'Workspace Sans'; src: url('../fonts/NotoSans-Bold.ttf'); font-weight: 700; }
  .workspace { width: 100; height: 150; flex-direction: column; padding-top: 4; padding-bottom: 4; padding-left: 4; padding-right: 4; gap: 1.5; overflow: scroll; font-family: 'Workspace Sans'; font-weight: 400; color: #202124; }
  .title { font-family: 'Workspace Sans'; height: 6; flex-shrink: 0; overflow: hidden; font-size: 4; font-weight: 700; color: #202124; }
  .status { font-family: 'Workspace Sans'; height: 6; overflow: scroll; font-size: 2.4; line-height: 1.25; color: #4d5156; flex-shrink: 0; }
  .row { width: 92; flex-direction: row; gap: 1; flex-shrink: 0; }
  .control { font-family: 'Workspace Sans'; flex-grow: 1; flex-basis: 0; min-width: 0; height: 7; padding-left: 1; padding-right: 1; }
  .label { font-family: 'Workspace Sans'; font-weight: 400; font-size: 2.6; line-height: 1.2; height: 3.5; min-height: 0; pointer-events: none; }
  .body-wrap { width: 92; height: 34; padding-top: 2; padding-bottom: 2; padding-left: 2; padding-right: 2; overflow: scroll; background-color: #f0f2f5; border-radius: 2; flex-shrink: 0; }
  .body { font-family: 'Workspace Sans'; width: 88; font-size: 2.8; line-height: 1.35; color: #202124; }
  .fields { width: 92; height: 48; flex-direction: column; gap: 1; flex-shrink: 0; overflow: scroll; }
  .field { width: 92; height: 7; min-height: 7; padding-left: 2; padding-right: 2; flex-shrink: 0; justify-content: flex-start; }
  .field-label { font-family: 'Workspace Sans'; font-weight: 400; font-size: 2.6; line-height: 1.2; height: 3.5; min-height: 0; pointer-events: none; }
  .qr { width: 35; height: 35; flex-shrink: 0; }
  .feedback { font-family: 'Workspace Sans'; width: 92; height: 9; font-size: 2.5; line-height: 1.2; color: #174ea6; overflow: scroll; flex-shrink: 0; }
  .editor { width: 92; flex-direction: column; gap: 1; padding-top: 1; padding-bottom: 1; background-color: #e8f0fe; flex-shrink: 0; }
</style>
<Panel id="workspace-root" class="workspace">
  <div id="workspace-title" class="title">Ava / Dialogue</div>
  <div id="workspace-status" class="status">Loading shared workspace...</div>
  <div class="row">
    <Button id="nav-chat" class="control"><ButtonLabel class="label">Dialogue</ButtonLabel></Button>
    <Button id="nav-character" class="control"><ButtonLabel class="label">Character</ButtonLabel></Button>
    <Button id="nav-connections" class="control"><ButtonLabel class="label">Connect</ButtonLabel></Button>
    <Button id="nav-memory" class="control"><ButtonLabel class="label">Memory</ButtonLabel></Button>
  </div>
  <div id="connection-tabs" class="row">
    <Button id="sub-llm" class="control"><ButtonLabel class="label">LLM</ButtonLabel></Button>
    <Button id="sub-stt" class="control"><ButtonLabel class="label">STT</ButtonLabel></Button>
    <Button id="sub-tts" class="control"><ButtonLabel class="label">TTS</ButtonLabel></Button>
    <Button id="sub-transfer" class="control"><ButtonLabel class="label">Transfer</ButtonLabel></Button>
  </div>
  <div id="camera-status" class="status">Camera: no capture requested</div>
  <div id="room-status" class="status">Room geometry: unavailable outside immersive MR</div>
  <div class="body-wrap"><div id="workspace-body" class="body">Write a message or configure your independent providers.</div></div>
  <div id="record-navigation" class="row">
    <Button id="workspace-previous" class="control"><ButtonLabel class="label">Previous</ButtonLabel></Button>
    <div id="workspace-page" class="status">1 / 1</div>
    <Button id="workspace-next" class="control"><ButtonLabel class="label">Next</ButtonLabel></Button>
  </div>
  <div id="workspace-fields" class="fields">
    <Button id="field-0" class="field"><ButtonLabel id="field-label-0" class="field-label">Field</ButtonLabel></Button>
    <Button id="field-1" class="field"><ButtonLabel id="field-label-1" class="field-label">Field</ButtonLabel></Button>
    <Button id="field-2" class="field"><ButtonLabel id="field-label-2" class="field-label">Field</ButtonLabel></Button>
    <Button id="field-3" class="field"><ButtonLabel id="field-label-3" class="field-label">Field</ButtonLabel></Button>
    <Button id="field-4" class="field"><ButtonLabel id="field-label-4" class="field-label">Field</ButtonLabel></Button>
    <Button id="field-5" class="field"><ButtonLabel id="field-label-5" class="field-label">Field</ButtonLabel></Button>
  </div>
  <div id="transfer-image" class="row">
    <img id="pairing-qr" class="qr" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" />
    <div id="pairing-pin" class="body">Generate an encrypted QR link. PIN appears here.</div>
  </div>
  <div id="chat-actions" class="row">
    <Button id="workspace-edit-chat" class="control"><ButtonLabel class="label">Write message</ButtonLabel></Button>
    <Button id="workspace-listen" class="control"><ButtonLabel id="workspace-listen-label" class="label">Microphone</ButtonLabel></Button>
    <Button id="workspace-look" class="control"><ButtonLabel class="label">Look / camera</ButtonLabel></Button>
  </div>
  <div id="settings-actions" class="row">
    <Button id="workspace-save" class="control"><ButtonLabel class="label">Save</ButtonLabel></Button>
    <Button id="workspace-test" class="control"><ButtonLabel id="workspace-test-label" class="label">Test provider</ButtonLabel></Button>
    <Button id="workspace-clear-key" class="control"><ButtonLabel class="label">Clear key</ButtonLabel></Button>
    <Button id="workspace-preset" class="control"><ButtonLabel class="label">Preset</ButtonLabel></Button>
  </div>
  <div id="connection-actions" class="row">
    <Button id="workspace-free-preset" class="control"><ButtonLabel class="label">OpenRouter free preset</ButtonLabel></Button>
    <Button id="workspace-copy-key" class="control"><ButtonLabel class="label">Copy LLM key to TTS</ButtonLabel></Button>
    <Button id="workspace-browser-voice" class="control"><ButtonLabel class="label">Next browser voice</ButtonLabel></Button>
  </div>
  <div id="memory-actions" class="row">
    <Button id="workspace-memory-add" class="control"><ButtonLabel class="label">Add note</ButtonLabel></Button>
    <Button id="workspace-memory-search" class="control"><ButtonLabel class="label">Search</ButtonLabel></Button>
    <Button id="workspace-memory-reset" class="control"><ButtonLabel class="label">Show all</ButtonLabel></Button>
    <Button id="workspace-memory-clear" class="control"><ButtonLabel id="workspace-clear-label" class="label">Clear all</ButtonLabel></Button>
  </div>
  <div id="transfer-actions" class="row">
    <Button id="workspace-transfer" class="control"><ButtonLabel class="label">Generate settings QR</ButtonLabel></Button>
    <Button id="workspace-copy-link" class="control"><ButtonLabel class="label">Copy pairing link</ButtonLabel></Button>
  </div>
  <div id="receiver-actions" class="row">
    <Button id="workspace-receiver-pin" class="control"><ButtonLabel id="workspace-receiver-pin-label" class="label">Enter receiver PIN</ButtonLabel></Button>
    <Button id="workspace-receiver-apply" class="control"><ButtonLabel class="label">Apply settings</ButtonLabel></Button>
    <Button id="workspace-receiver-skip" class="control"><ButtonLabel class="label">Skip pairing</ButtonLabel></Button>
  </div>
  <div id="workspace-editor" class="editor">
    <div id="workspace-editor-label" class="status">Text editor</div>
    <div id="workspace-editor-value" class="status"></div>
    <div class="row">
      <Button id="workspace-editor-focus" class="control"><ButtonLabel class="label">Keyboard</ButtonLabel></Button>
      <Button id="workspace-editor-done" class="control"><ButtonLabel class="label">Done / send</ButtonLabel></Button>
      <Button id="workspace-editor-cancel" class="control"><ButtonLabel class="label">Cancel</ButtonLabel></Button>
    </div>
  </div>
  <div id="workspace-feedback" class="feedback"></div>
  <div class="row">
    <Button id="workspace-enter-mr" class="control"><ButtonLabel class="label">Enter MR</ButtonLabel></Button>
    <Button id="workspace-enter-vr" class="control"><ButtonLabel class="label">Enter VR</ButtonLabel></Button>
    <Button id="workspace-exit" class="control"><ButtonLabel class="label">Exit XR</ButtonLabel></Button>
  </div>
</Panel>
